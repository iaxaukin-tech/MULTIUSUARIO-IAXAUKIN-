rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global safety net (catch-all) default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Standardized Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function getUserRole(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function getUsername(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.username;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserRole(request.auth.uid) == 'ADMIN';
    }

    // Rules for /users/{userId}
    match /users/{userId} {
      // Allow custom validation logic for User properties
      function isValidUser(data) {
        return data.id == request.auth.uid
          && data.username is string && data.username.size() >= 3 && data.username.size() <= 32
          && data.email is string && data.email.size() <= 128
          && data.role in ['ADMIN', 'USER']
          && data.plan in ['RETAIL', 'PRO', 'INSTITUTIONAL']
          && data.status in ['PENDING_APPROVAL', 'ACTIVE', 'EXPIRED', 'INACTIVE']
          && data.joinedAt is string
          && (
            !('dailyUsage' in data) || (
              data.dailyUsage.date is string
              && data.dailyUsage.count is int
            )
          )
          && (
            !('expiresAt' in data) || data.expiresAt is string
          )
          && (
            !('paymentReceiptUrl' in data) || (data.paymentReceiptUrl is string && data.paymentReceiptUrl.size() <= 1000000)
          )
          && (
            !('lastAnalysisAt' in data) || data.lastAnalysisAt is string
          )
          && (
            !('isTelemetryLimited' in data) || data.isTelemetryLimited is bool
          )
          && (
            !('allowedTotalAnalyses' in data) || (data.allowedTotalAnalyses is int || data.allowedTotalAnalyses == null)
          )
          && (
            !('totalAnalysesCount' in data) || data.totalAnalysesCount is int
          )
          && (
            !('referredBy' in data) || data.referredBy is string
          )
          && (
            !('referralCode' in data) || data.referralCode is string
          )
          && (
            !('webhookUrl' in data) || data.webhookUrl is string
          )
          && (
            !('telegramChannelId' in data) || data.telegramChannelId is string
          )
          && (
            !('telegramBotToken' in data) || data.telegramBotToken is string
          )
          && (
            !('discordWebhookUrl' in data) || data.discordWebhookUrl is string
          )
          && (
            !('onboardingCompleted' in data) || data.onboardingCompleted is bool
          )
          && (
            !('onboardingData' in data) || (
              data.onboardingData.source is string
              && data.onboardingData.goldExperience is string
              && data.onboardingData.primaryGoal is string
              && data.onboardingData.retentionPreference is string
              && data.onboardingData.completedAt is string
            )
          );
      }

      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin() || (
        isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.plan == 'INSTITUTIONAL'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'ACTIVE'
        && (
          resource.data.referredBy == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.referralCode
          || resource.data.referredBy == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
        )
      );

      // Standard users can initialize their user profile
      allow create: if isSignedIn() 
        && isValidId(userId) 
        && userId == request.auth.uid 
        && isValidUser(incoming())
        // Restrict role and status self-elevation on initial creation except for verified institutional owner
        && (
          (request.auth.token.email == 'iaxaukin@gmail.com' && incoming().role == 'ADMIN' && incoming().status == 'ACTIVE')
          || (incoming().role == 'USER' && incoming().status in ['INACTIVE', 'PENDING_APPROVAL'])
        );

      // Action-based updates
      allow update: if isSignedIn() && (
        isAdmin() || (
          // Standard User update path
          request.auth.uid == userId 
          && isValidUser(incoming())
          && incoming().role == existing().role // Role is immutable
          && incoming().id == existing().id // ID is immutable
          && incoming().username == existing().username // Username is immutable
          && incoming().joinedAt == existing().joinedAt // joinedAt is immutable
          && (
            // Action 1: Upload transaction hash for manual approval
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['paymentReceiptUrl', 'status', 'plan']) 
              && incoming().status == 'PENDING_APPROVAL'
            ) ||
            // Action 2: Activate with Code / Coupon
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'plan', 'expiresAt', 'isTelemetryLimited', 'allowedTotalAnalyses', 'totalAnalysesCount'])
              && incoming().status == 'ACTIVE'
            ) ||
            // Action 3: Record analysis or update dailyUsage count
            (
              incoming().diff(existing()).affectedKeys().hasAny(['lastAnalysisAt', 'dailyUsage', 'totalAnalysesCount'])
              && incoming().diff(existing()).affectedKeys().hasOnly(['lastAnalysisAt', 'dailyUsage', 'totalAnalysesCount'])
            ) ||
            // Action 4: Sync email on login (some verified email flows)
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['email'])
            ) ||
            // Action 5: Reset/initialize dailyUsage cache
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['dailyUsage'])
            ) ||
            // Action 6: Save community integrations / customize referral code for Institutional socio
            (
              incoming().diff(existing()).affectedKeys().hasAny(['referralCode', 'webhookUrl', 'telegramChannelId', 'telegramBotToken', 'discordWebhookUrl'])
              && incoming().diff(existing()).affectedKeys().hasOnly(['referralCode', 'webhookUrl', 'telegramChannelId', 'telegramBotToken', 'discordWebhookUrl'])
            ) ||
            // Action 7: Retrospectively save affiliate referral code
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['referredBy'])
            ) ||
            // Action 8: Onboarding data
            (
              incoming().diff(existing()).affectedKeys().hasAny(['onboardingCompleted', 'onboardingData'])
              && incoming().diff(existing()).affectedKeys().hasOnly(['onboardingCompleted', 'onboardingData'])
            )
          )
        )
      );

      allow delete: if isAdmin();
    }

    // Rules for /activationCodes/{codeId}
    match /activationCodes/{codeId} {
      allow get: if isSignedIn() && isValidId(codeId);
      allow list: if isAdmin(); // Prevent scrapers/brute-forcers from reading all active codes
      allow create, delete: if isAdmin();
      
      allow update: if isSignedIn() && (
        isAdmin() || (
          // Action: Consume voucher
          existing().isUsed == false 
          && incoming().isUsed == true
          && incoming().usedBy == getUsername(request.auth.uid)
          && incoming().diff(existing()).affectedKeys().hasOnly(['isUsed', 'usedBy'])
        )
      );
    }

    // Rules for /analysisHistory/{analysisId}
    match /analysisHistory/{analysisId} {
      allow get: if isSignedIn() && isValidId(analysisId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid; // Secure Query Enforcer
      
      allow create: if isSignedIn()
        && isValidId(analysisId)
        && incoming().userId == request.auth.uid
        && incoming().createdAt is string
        && incoming().analysisText is string
        && incoming().analysisText.size() <= 20000; // Size limit boundary check
        
      allow update, delete: if isAdmin();
    }

    // Rules for /usernames/{username}
    match /usernames/{username} {
      allow get: if true; // Fully public to check if a username is taken before signing up
      allow list: if false; // Block listing completely to prevent PII harvesting/leaks
      
      allow create: if isSignedIn()
        && isValidId(username)
        && incoming().uid == request.auth.uid;
        
      allow update, delete: if isAdmin();
    }

    // Rules for /settings/{settingId}
    match /settings/{settingId} {
      allow get: if true; // Readable by all operators and visitors
      allow list: if false; // Block listing to prevent leaking settings structure
      allow create, update, delete: if isAdmin(); // Only admins can design/alter core settings
    }

    // Rules for /suggestions/{suggestionId}
    match /suggestions/{suggestionId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(suggestionId)
        && incoming().userId == request.auth.uid
        && incoming().createdAt is string
        && incoming().title is string && incoming().title.size() <= 200
        && incoming().description is string && incoming().description.size() <= 4000;
      allow update, delete: if isAdmin();
    }

  }
}
